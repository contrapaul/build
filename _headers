# Cache rules, as in cloud.contrapaul.com. The site's own HTML, CSS and JS
# must never be served stale: a fix pushed the morning of the talk has to
# reach every phone in the hall. The browser keeps the file and asks whether
# it changed, which is normally a tiny 304.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Fonts never change without a new filename: cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
